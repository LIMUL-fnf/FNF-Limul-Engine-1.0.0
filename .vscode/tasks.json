{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Windows",
      "type": "process",
      "command": "C:/HaxeToolkit/haxe/lime.exe",
      "args": [
        "build",
        "windows",
        "-release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Lime: Test Windows (Optimized)",
      "type": "process",
      "command": "C:/Windows/System32/WindowsPowerShell/v1.0/powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/run-windows-release.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
